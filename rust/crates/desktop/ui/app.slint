// UI desktop MG101 Studio (Slint) — trzy panele: [zakładki+lista] | [edytor] |
// [inspektor]. Cała logika jest w Rust (ViewModel); tu tylko widok i wywołania
// callbacków. Struktury lustrzane do desktop::vm.

import { Button, ListView, LineEdit, TextEdit, TabWidget, CheckBox, ComboBox, Slider, VerticalBox, HorizontalBox, GroupBox, ScrollView } from "std-widgets.slint";

export struct PatchRowUi {
    id: string,
    slot: int,
    name: string,
    origin: string,
    ir: bool,
}

export struct ParamRowUi {
    name: string,
    label: string,
    value: int,
    minimum: int,
    maximum: int,
    control: string, // "slider" | "toggle" | "enum"
    unit: string,
    midi-cc: int, // -1 = nieznany
    confirmed: bool, // false = wartość/semantyka "inferred"
    display: string, // wartość fizyczna (dB/Hz), pusta gdy brak wzoru
    enum-label: string,      // enum: etykieta bieżącego stanu (np. PRECEDE)
    enum-next: int,          // enum: wartość surowa następnego stanu (do toggle 2-stanowego)
    enum-next-label: string, // enum: etykieta następnego stanu (napis na przycisku)
    enum-labels: [string],   // enum: wszystkie etykiety (model dropdownu)
    enum-values: [int],      // enum: wszystkie wartości surowe (równoległe)
    enum-index: int,         // enum: indeks bieżącego stanu (−1 = nieznany)
    addr: string,       // offset bajtu w hex (np. "0x0029") — spina z Binary/Changes
}

export struct BlockRowUi {
    block: string,
    icon: string,       // generyczna ikona typu bloku (nie modelu)
    model-name: string,
    bypassed: bool,
    params: [ParamRowUi],
    models: [string],   // nazwy modeli dostępnych w bloku (picker)
    model-index: int,   // indeks aktywnego modelu w `models`
}

export struct ChatRowUi {
    role: string,       // "user" | "assistant" | "tool"
    text: string,
}

export struct DetailUi {
    id: string,
    name: string,
    bpm: int,
    revision: int,
    ir: bool,
    blocks: [BlockRowUi],
}

export struct SlotRowUi {
    index: int,
    label: string,      // etykieta footswitcha: 1A..9D
    patch-id: string,   // id patcha po otwarciu (device-<bank>-<index>) — do podświetlenia
    name: string,
    occupied: bool,
    writable: bool,
}

// Kolekcja (grupa) w bibliotece + czy należy do niej bieżący patch.
export struct CollectionUi {
    id: string,
    name: string,
    count: int,
    member: bool,       // czy otwarty patch jest w tej kolekcji
}

// Publiczne ŹRÓDŁO patchy — sam odnośnik, nie plik. Aplikacja nie rozpowszechnia
// cudzych patchy (brak licencji na redystrybucję) — odsyła do autora.
export struct SourceUi {
    name: string,
    author: string,
    license: string,
    url: string,
    paid: bool,
    description: string,
}

export struct BinGroupUi {
    label: string,
    addr: string,       // offset w hex, gotowy (np. "0x0004")
    kind: string,       // header|selector|param|meta|name|ir
    length: int,
    hex: string,        // bajty w hex (gotowe do wyświetlenia)
    dec: string,        // bajty dziesiętnie
    truncated: bool,
}

export component AppWindow inherits Window {
    title: root.t-app-title;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 520px;

    // --- Dane (wypełniane z Rust) ---
    in property <[PatchRowUi]> patches;
    in property <[SlotRowUi]> slots;
    in property <DetailUi> detail;
    in property <bool> has-selection;
    in property <string> current-id;
    in property <int> active-tab;          // 0=User 1=Factory 2=Library
    in property <string> changes-text;
    in property <string> error-text;
    in property <int> lang-index;          // 0=EN 1=PL

    // Inspektor binarny (W5)
    in property <[BinGroupUi]> bin-groups;
    property <bool> bin-hex: true;         // true=hex, false=dec

    // Urządzenie (W2/W6): wykryty model + status zrzutu
    in property <string> device-label;     // np. "NUX MG-101" lub "brak urządzenia"
    in property <bool> device-connected;
    in property <bool> dump-busy;
    in property <bool> dump-ready;         // jest zrzut gotowy do importu
    in property <string> dump-status;      // postęp/komunikat zrzutu
    in property <int> active-slot: -1;     // aktywny preset na urządzeniu (index User 0..35, -1=nieznany)
    in property <bool> device-live;        // trwałe połączenie MIDI (nasłuch presetów) aktywne
    in property <[string]> device-models;  // lista modeli z rejestru (dropdown w nagłówku)
    in property <int> device-index;        // wybrany model urządzenia w dropdownie
    in property <bool> qt-running;         // QuickTone działa równolegle (ostrzeżenie sync)
    in property <string> midi-log;         // bufor monitora MIDI (linie)
    in property <bool> midi-monitor-on;    // nasłuch monitora włączony
    in property <int> exp-index: -1;       // centralne przypisanie EXP (0=off..6=RVB, -1=nieznane)
    in property <int> drum-tempo: -1;      // aktualne tempo DRUM (BPM, -1=nieznane) — odczyt SysEx
    // Katalog wzorców DRUM (z Rust) — dwupoziomowy wybór: grupa → wzorzec.
    in property <[string]> drum-group-names;       // 10 grup (ROCK, CTRY, …)
    in property <[[string]]> drum-group-patterns;  // wzorce w każdej grupie
    in property <[int]> drum-group-base;           // baza CC82 pierwszego wzorca grupy
    property <int> drum-group-index: 0;            // wybrana grupa (stan UI)

    // Metadane otwartego patcha: kto jest autorem, skąd pochodzi, co wolno.
    in property <string> meta-author;
    in property <string> meta-source;
    in property <string> meta-source-url;
    in property <string> meta-license;
    in property <string> meta-notes;
    in property <int> meta-rating;         // 0..5 (0 = brak oceny)
    in property <bool> meta-favorite;
    in property <[string]> meta-tags;
    in property <[CollectionUi]> collections;
    in property <[SourceUi]> patch-sources;

    // Etykiety nowych sekcji (i18n z Rust) — nic tu nie może być wpisane na sztywno,
    // bo wtedy przy EN zostawałby polski tekst (regresja zgłoszona przez użytkownika).
    in property <string> t-qt-warning;
    in property <string> t-connect-hint;
    in property <string> t-connect-control;
    in property <string> t-clear;
    in property <string> t-save-file;
    in property <string> t-open;
    in property <string> t-add;
    in property <string> t-create;
    in property <string> t-set;
    in property <string> t-midi-listen;
    in property <string> t-midi-active;
    in property <string> t-midi-idle;
    in property <string> t-midi-no-device;
    in property <string> t-midi-empty;
    in property <string> t-drum-hint;
    in property <string> t-drum-tempo;
    in property <string> t-drum-volume;
    in property <string> t-drum-group;
    in property <string> t-drum-pattern;
    in property <string> t-meta;
    in property <string> t-meta-no-selection;
    in property <string> t-meta-author;
    in property <string> t-meta-source;
    in property <string> t-meta-source-url;
    in property <string> t-meta-license;
    in property <string> t-meta-notes;
    in property <string> t-meta-rating;
    in property <string> t-meta-no-rating;
    in property <string> t-meta-favorite;
    in property <string> t-meta-save;
    in property <string> t-meta-tags;
    in property <string> t-meta-collections;
    in property <string> t-ph-author;
    in property <string> t-ph-source;
    in property <string> t-ph-license;
    in property <string> t-ph-tag;
    in property <string> t-ph-collection;
    in property <string> t-sources;
    in property <string> t-sources-intro;
    in property <string> t-sources-paid;
    in property <string> t-sources-author;
    in property <string> t-sources-license;
    in property <string> t-sources-open;
    in property <string> t-slot-hint;
    in property <string> t-fields;
    in property <string> t-role-tool;
    in property <string> t-role-assistant;

    // Agent (rozmowa + rozliczenie sesji)
    in property <[ChatRowUi]> chat-rows;
    in property <bool> agent-busy;
    in property <string> agent-status;   // np. „Agent pracuje… 12 s · narzędzie: list_patches"

    // Zakładka MCP: stan mostka i zewnętrznych agentów (Claude Code i inni klienci).
    in property <bool> mcp-bridge-on;
    in property <int> mcp-clients;       // ilu klientów trzyma połączenie TERAZ
    in property <string> mcp-status;     // nagłówek (podłączony / bezczynny / wyłączony)
    in property <string> mcp-detail;     // adres, licznik żądań, ostatnie narzędzie
    in property <string> mcp-cmd;        // gotowe polecenie/konfiguracja do podpięcia klienta
    in property <string> t-mcp-hint;
    in property <string> usage-text;

    // Ustawienia AI
    in property <int> provider-index;      // 0=Anthropic 1=OpenAI-compatible
    in-out property <string> cfg-endpoint;
    in-out property <string> cfg-model;
    in-out property <string> cfg-key;
    in-out property <string> cfg-claude-bin;     // ścieżka do binarki Claude Code
    in property <bool> cfg-bridge;           // mostek MCP → żywe Studio
    in property <string> cfg-bridge-status;  // np. „Mostek działa: 127.0.0.1:10101"
    in property <string> t-subscription;
    in property <string> t-cc-hint;
    in property <string> t-cc-bin;
    in property <string> t-bridge;

    // --- Etykiety (i18n z Rust) ---
    in property <string> t-app-title;
    in property <string> t-tab-user;
    in property <string> t-tab-factory;
    in property <string> t-tab-library;
    in property <string> t-no-selection;
    in property <string> t-chain;
    in property <string> t-bypass;
    in property <string> t-name;
    in property <string> t-bpm;
    in property <string> t-changes;
    in property <string> t-changes-header;
    in property <string> t-binary;
    in property <string> t-agent;
    in property <string> t-mcp;
    in property <string> t-no-changes;
    in property <string> t-duplicate;
    in property <string> t-delete;
    in property <string> t-revert;
    in property <string> t-import;
    in property <string> t-export;
    in property <string> t-language;
    in property <string> t-fetch;
    in property <string> t-import-dump;
    in property <string> t-copy-library;
    // tooltipy (tłumaczone)
    in property <string> t-tip-value;
    in property <string> t-tip-inc;
    in property <string> t-tip-dec;
    in property <string> t-tip-import;
    in property <string> t-tip-export;
    in property <string> t-tip-duplicate;
    in property <string> t-tip-delete;
    in property <string> t-tip-revert;
    in property <string> t-tip-copy-library;
    in property <string> t-tip-toggle;
    in property <string> t-empty-slot;
    in property <string> t-rev;
    in property <string> t-settings;
    in property <string> t-provider;
    in property <string> t-endpoint;
    in property <string> t-model;
    in property <string> t-key;
    in property <string> t-save;
    in property <string> t-send;

    // --- Zdarzenia (obsługa w Rust) ---
    // Mutacje niosą `rev` (rewizja widziana przez użytkownika) — egzekwowany
    // optimistic concurrency (review E7/K1), nie doczytywany tuż przed zapisem.
    callback switch-tab(int);
    callback switch-lang(int);
    callback select(string);
    callback set-name(string, int, string);            // id, rev, text
    callback set-bpm(string, int, string);             // id, rev, text
    callback set-param(string, int, string, string, float, int); // id, rev, block, param, value, midi-cc
    callback set-bypass(string, int, string, bool);    // id, rev, block, bypassed
    callback duplicate(string, int);                   // id, rev
    callback delete-patch(string, int);                // id, rev
    callback switch-model(string, int, string, int);   // id, rev, block, model-index
    callback import();
    callback export-patch(string, int);                // id, rev
    callback revert();
    callback dismiss-error();
    callback send-message(string);                     // treść wiadomości do agenta
    callback save-settings(int, string, string, string, bool, string); // backend, endpoint, model, key, mostek, ścieżka claude
    callback connect-dump();                           // W2: połącz i zrzuć banki
    callback import-dump();                             // W2: import zrzutu do Biblioteki
    callback open-slot(string, int);                   // W2: otwórz slot (bank, index) w edytorze
    callback select-device(int);                       // W6: wybór modelu urządzenia z dropdownu
    callback copy-to-library();                        // kopiuj otwarty slot urządzenia do Biblioteki
    callback toggle-midi-monitor();                    // monitor MIDI: włącz/wyłącz
    callback clear-midi-log();                         // monitor MIDI: wyczyść
    callback save-midi-log();                          // monitor MIDI: zapisz do pliku
    callback set-exp(int);                             // centralne EXP: wyślij CC79 = index
    callback send-control(int, int);                   // generyczny CC: wyślij CC<cc> = <value> (DRUM/LOOP)
    callback send-drum-tempo(int);                     // DRUM tempo: wyślij ramkę SysEx BPM
    callback ensure-agent-key();                       // leniwy odczyt klucza API z magazynu
    // Metadane / kolekcje / źródła
    callback save-meta(string, string, string, string, string, int, bool); // autor, źródło, url, licencja, notatki, ocena, ulubiony
    callback add-tag(string);
    callback remove-tag(string);
    callback toggle-collection(string, bool);          // id kolekcji, czy dodać
    callback new-collection(string);                   // nazwa nowej kolekcji
    callback open-url(string);                         // otwórz link w przeglądarce
    // Zakładki prawego panelu. Własny pasek zamiast TabWidget: przy 9 zakładkach
    // w panelu 340px TabWidget ściskał etykiety tak, że się zlewały, a ostatnia była
    // ucięta — i nie oferował przewijania. Tu tytuły są DANYMI, a `right-tab` stanem.
    property <[string]> tab-titles: [
        root.t-changes, root.t-binary, root.t-agent, root.t-mcp,
        "MIDI", "DRUM", root.t-meta, root.t-sources, root.t-settings,
    ];
    property <int> right-tab: 0;
    // Indeksy zakładek korzystających z agenta (klucz API czytany leniwie).
    property <int> tab-agent: 2;
    property <int> tab-settings: 8;

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ===== Nagłówek globalny: urządzenie + pobieranie =====
        Rectangle {
            height: 50px;
            background: #17171c;
            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                // Stan połączenia + wybór modelu urządzenia (dropdown pod kolejne).
                Text {
                    text: root.device-connected ? "🎸" : "⚪";
                    font-size: 17px;
                    vertical-alignment: center;
                }
                ComboBox {
                    min-width: 170px;
                    model: root.device-models;
                    current-index: root.device-index;
                    selected(v) => { root.select-device(self.current-index); }
                }
                Button {
                    text: root.t-fetch;
                    enabled: root.device-connected && !root.dump-busy;
                    clicked => { root.connect-dump(); }
                }
                Button {
                    text: root.t-import-dump;
                    enabled: root.dump-ready && !root.dump-busy;
                    clicked => { root.import-dump(); }
                }
                Text {
                    text: root.dump-status;
                    color: #8a8a96;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                // Centralne przypisanie pedału EXP (CC79) — zmiana wysyła na urządzenie.
                if root.device-connected: Text {
                    text: "EXP:";
                    color: #8a8a96;
                    vertical-alignment: center;
                }
                if root.device-connected: ComboBox {
                    min-width: 90px;
                    model: ["---", "WAH", "EFX", "AMP", "MOD", "DLY", "RVB"];
                    current-index: root.exp-index;
                    selected(v) => { root.set-exp(self.current-index); }
                }
                // Ostrzeżenie: QuickTone działa równolegle — sync może się rozjechać
                // (zmiany presetu w QT nie emitują Program Change, którego nasłuchujemy).
                if root.qt-running: Text {
                    text: root.t-qt-warning;
                    color: #e0a020;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.device-connected ? "" : root.device-label;
                    color: #6a6a76;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

    HorizontalBox {
        padding: 0px;
        vertical-stretch: 1;

        // ===== Panel 1: zakładki + lista =====
        Rectangle {
            width: 320px;
            background: #1e1e24;
            VerticalBox {
                padding: 8px;
                spacing: 6px;

                // zakładki User / Factory / Library
                HorizontalBox {
                    spacing: 4px;
                    Button {
                        text: root.t-tab-user;
                        primary: root.active-tab == 0;
                        clicked => { root.switch-tab(0); }
                    }
                    Button {
                        text: root.t-tab-factory;
                        primary: root.active-tab == 1;
                        clicked => { root.switch-tab(1); }
                    }
                    Button {
                        text: root.t-tab-library;
                        primary: root.active-tab == 2;
                        clicked => { root.switch-tab(2); }
                    }
                }

                // lista biblioteki (zakładka Library)
                if root.active-tab == 2: ListView {
                    for row[i] in root.patches: Rectangle {
                        height: 44px;
                        background: row.id == root.current-id ? #3a3a48 : transparent;
                        TouchArea { clicked => { root.select(row.id); } }
                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                width: 26px;
                                text: row.slot < 10 ? "0" + row.slot : row.slot;
                                color: #8a8a96;
                                vertical-alignment: center;
                            }
                            VerticalBox {
                                padding: 0px;
                                spacing: 1px;
                                Text {
                                    text: row.name == "" ? "—" : row.name;
                                    color: white;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.origin;
                                    color: #8a8a96;
                                    font-size: 11px;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: row.ir ? "IR" : "";
                                color: #6ab0ff;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // podpowiedź transferu (zakładki urządzenia): klik slotu = kopia do Biblioteki
                if root.active-tab != 2: Text {
                    text: root.device-connected
                        ? root.t-slot-hint
                        : root.t-connect-hint;
                    color: #6a6a76;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                // widok slotów urządzenia (zakładki User/Factory) — klik otwiera slot
                if root.active-tab != 2: ListView {
                    for s[i] in root.slots: row := Rectangle {
                        // zaznaczony w edytorze (otwarty patch) vs aktywny na urządzeniu (live preset)
                        property <bool> is-selected: s.occupied && s.patch-id == root.current-id;
                        property <bool> is-active: root.active-tab == 0 && s.index == root.active-slot;
                        height: 36px;
                        background: row.is-selected ? #3a3a48
                            : (row.is-active ? #34304a
                            : (touch.has-hover && s.occupied ? #2f2f38 : transparent));
                        touch := TouchArea {
                            enabled: s.occupied;
                            clicked => {
                                root.open-slot(root.active-tab == 0 ? "user" : "factory", s.index);
                            }
                        }
                        HorizontalBox {
                            padding-left: 8px;
                            spacing: 8px;
                            Text {
                                width: 30px;
                                text: s.label;
                                color: row.is-active ? #c8b6ff : #8a8a96;
                                font-weight: row.is-active ? 700 : 400;
                                vertical-alignment: center;
                            }
                            Text {
                                text: s.occupied ? s.name : root.t-empty-slot;
                                color: s.occupied ? white : #6a6a76;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: s.writable ? "" : "🔒";
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // pasek akcji — rzędy tak, by WSZYSTKIE przyciski się mieściły (320px)
                // Transfer (zakładki urządzenia): kopiuje otwarty slot do Biblioteki
                // jako trwały wpis i przełącza na Bibliotekę, żeby był widoczny.
                if root.active-tab != 2: Button {
                    text: "⭳ " + root.t-copy-library;
                    enabled: root.has-selection;
                    clicked => { root.copy-to-library(); }
                    Tooltip { text: @markdown("\{root.t-tip-copy-library}"); }
                }
                HorizontalBox {
                    spacing: 4px;
                    Button {
                        text: root.t-import;
                        clicked => { root.import(); }
                        Tooltip { text: @markdown("\{root.t-tip-import}"); }
                    }
                    Button {
                        text: root.t-export;
                        enabled: root.has-selection;
                        clicked => { root.export-patch(root.current-id, root.detail.revision); }
                        Tooltip { text: @markdown("\{root.t-tip-export}"); }
                    }
                    Button {
                        text: root.t-duplicate;
                        enabled: root.has-selection;
                        clicked => { root.duplicate(root.current-id, root.detail.revision); }
                        Tooltip { text: @markdown("\{root.t-tip-duplicate}"); }
                    }
                }
                HorizontalBox {
                    spacing: 4px;
                    Button {
                        text: root.t-delete;
                        enabled: root.has-selection;
                        clicked => { root.delete-patch(root.current-id, root.detail.revision); }
                        Tooltip { text: @markdown("\{root.t-tip-delete}"); }
                    }
                    Button {
                        text: root.t-revert;
                        clicked => { root.revert(); }
                        Tooltip { text: @markdown("\{root.t-tip-revert}"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // wybór języka
                HorizontalBox {
                    spacing: 6px;
                    Text { text: root.t-language + ":"; color: #8a8a96; vertical-alignment: center; }
                    ComboBox {
                        model: ["EN", "PL"];
                        current-index: root.lang-index;
                        selected(v) => { root.switch-lang(self.current-index); }
                    }
                }
            }
        }

        // ===== Panel 2: edytor =====
        Rectangle {
            horizontal-stretch: 1;
            background: #26262e;
            VerticalBox {
                padding: 12px;
                spacing: 8px;

                if !root.has-selection: Text {
                    text: root.t-no-selection;
                    color: #8a8a96;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if root.has-selection: HorizontalBox {
                    spacing: 12px;
                    VerticalBox {
                        padding: 0px;
                        Text { text: root.t-name; color: #8a8a96; font-size: 11px; }
                        LineEdit {
                            text: root.detail.name;
                            accepted(v) => { root.set-name(root.detail.id, root.detail.revision, v); }
                        }
                    }
                    VerticalBox {
                        padding: 0px;
                        width: 120px;
                        Text { text: root.t-bpm; color: #8a8a96; font-size: 11px; }
                        LineEdit {
                            text: root.detail.bpm;
                            input-type: number;
                            accepted(v) => { root.set-bpm(root.detail.id, root.detail.revision, v); }
                        }
                    }
                    VerticalBox {
                        padding: 0px;
                        Text { text: root.t-rev; color: #8a8a96; font-size: 11px; }
                        Text { text: root.detail.revision; color: white; }
                    }
                }

                if root.has-selection: Text {
                    text: root.t-chain;
                    color: white;
                    font-size: 14px;
                }

                if root.has-selection: ScrollView {
                    VerticalBox {
                        padding: 0px;
                        spacing: 8px;
                        for blk[bi] in root.detail.blocks: Rectangle {
                            background: #2f2f38;
                            border-radius: 6px;
                            VerticalBox {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalBox {
                                    // Generyczna ikona typu bloku (bez skeuomorfizmu QT).
                                    Text {
                                        text: blk.icon;
                                        font-size: 18px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: blk.block;
                                        color: white;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        model: blk.models;
                                        current-index: blk.model-index;
                                        selected(v) => { root.switch-model(root.detail.id, root.detail.revision, blk.block, self.current-index); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    CheckBox {
                                        text: root.t-bypass;
                                        checked: blk.bypassed;
                                        toggled => { root.set-bypass(root.detail.id, root.detail.revision, blk.block, self.checked); }
                                    }
                                }
                                for p[pi] in blk.params: HorizontalBox {
                                    spacing: 8px;
                                    HorizontalBox {
                                        width: 132px;
                                        padding: 0px;
                                        spacing: 4px;
                                        Text {
                                            // Etykieta katalogowa (GAIN), nie techniczna (gain).
                                            text: p.label;
                                            color: #c4c4cc;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            // Znacznik "inferred" — semantyka/zapis niepotwierdzone.
                                            text: p.confirmed ? "" : "≈";
                                            color: #e0a020;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Enum (np. POSITION Edge/Middle/Center): dropdown z nazwami
                                    // stanów; wybór ustawia własną wartość surową z katalogu.
                                    if p.control == "enum": ComboBox {
                                        min-width: 150px;
                                        model: p.enum-labels;
                                        current-index: p.enum-index;
                                        selected(v) => {
                                            root.set-param(root.detail.id, root.detail.revision, blk.block, p.name, p.enum-values[self.current-index], p.midi-cc);
                                        }
                                        Tooltip { text: @markdown("\{root.t-tip-toggle}"); }
                                    }
                                    // Nieznana wartość (poza listą) — pokaż surową obok dropdownu.
                                    if p.control == "enum" && p.enum-index < 0: Text {
                                        text: p.enum-label;
                                        color: #e0a020;
                                        vertical-alignment: center;
                                    }
                                    // Wartość toggle: przełącznik ON/OFF.
                                    if p.control == "toggle": Text {
                                        width: 54px;
                                        text: p.value == 0 ? "OFF" : "ON";
                                        color: white;
                                        vertical-alignment: center;
                                    }
                                    if p.control == "toggle": Button {
                                        text: p.value == 0 ? "→ ON" : "→ OFF";
                                        clicked => { root.set-param(root.detail.id, root.detail.revision, blk.block, p.name, p.value == 0 ? 1 : 0, p.midi-cc); }
                                    }
                                    // Wartość ciągła: EDYTOWALNE pole (walidacja zakresu w Rust —
                                    // wartość poza [min,max] jest odrzucana i pole wraca do zapisanej).
                                    if p.control == "slider": LineEdit {
                                        width: 56px;
                                        horizontal-alignment: center;
                                        input-type: number;
                                        text: p.value;
                                        accepted(v) => { root.set-param(root.detail.id, root.detail.revision, blk.block, p.name, self.text.to-float(), p.midi-cc); }
                                        Tooltip { text: @markdown("\{root.t-tip-value}"); }
                                    }
                                    // Fizyczna wartość (dB/Hz), gdy znany wzór — obok pola.
                                    if p.control == "slider" && p.display != "": Text {
                                        width: 60px;
                                        text: p.display;
                                        color: #9a9aa6;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    if p.control == "slider": Button {
                                        width: 30px;
                                        text: "−";
                                        clicked => { root.set-param(root.detail.id, root.detail.revision, blk.block, p.name, p.value - 1, p.midi-cc); }
                                        Tooltip { text: @markdown("\{root.t-tip-dec}"); }
                                    }
                                    if p.control == "slider": Button {
                                        width: 30px;
                                        text: "+";
                                        clicked => { root.set-param(root.detail.id, root.detail.revision, blk.block, p.name, p.value + 1, p.midi-cc); }
                                        Tooltip { text: @markdown("\{root.t-tip-inc}"); }
                                    }
                                    Text {
                                        // Zakres tylko dla suwaka (dla enum/toggle „0…255" myli);
                                        // CC (gdy znane) zawsze — istotne dla edycji na żywo.
                                        // Zakres (suwak) + CC (MIDI) + offset bajtu (spina z
                                        // panelami Binary/Changes, które adresują po offsecie).
                                        text: (p.control == "slider"
                                                ? p.minimum + "…" + p.maximum + (p.unit == "" ? "" : " " + p.unit)
                                                : "")
                                            + (p.midi-cc >= 0 ? "  CC" + p.midi-cc : "")
                                            + (p.addr == "" ? "" : "  " + p.addr);
                                        color: #6a6a76;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ===== Panel 3: inspektor =====
        Rectangle {
            width: 340px;
            background: #1e1e24;
            VerticalBox {
                padding: 8px;
                // Pasek zakładek: przewijalny w poziomie. Strzałki ◀ ▶ są aktywne tylko,
                // gdy jest co przewijać, a pasek przewijania stoi na stałe — żeby było
                // widać, że etykiety wychodzą poza panel (a nie że ich nie ma).
                HorizontalBox {
                    padding: 0px;
                    spacing: 2px;
                    Button {
                        text: "◀";
                        width: 26px;
                        enabled: tabbar.viewport-x < 0px;
                        clicked => {
                            tabbar.viewport-x = tabbar.viewport-x + 90px > 0px
                                ? 0px
                                : tabbar.viewport-x + 90px;
                        }
                    }
                    tabbar := ScrollView {
                        height: 34px;
                        horizontal-stretch: 1;
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: always-on;
                        HorizontalLayout {
                            spacing: 4px;
                            for t[i] in root.tab-titles: Rectangle {
                                border-radius: 6px;
                                // Aktywna zakładka wyraźnie odcięta tłem — sama pogrubiona
                                // czcionka ginęła w ciasnym pasku.
                                background: root.right-tab == i ? #3f3f52 : #26262e;
                                border-width: 1px;
                                border-color: root.right-tab == i ? #6c6c8a : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: t;
                                        color: root.right-tab == i ? white : #9a9aa6;
                                        font-size: 12px;
                                        font-weight: root.right-tab == i ? 700 : 400;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.right-tab = i;
                                        // Klucz API z magazynu czytamy LENIWIE — tylko przy
                                        // wejściu w zakładkę agenta/ustawień (patrz ensure-agent-key).
                                        if (i == root.tab-agent || i == root.tab-settings) {
                                            root.ensure-agent-key();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Button {
                        text: "▶";
                        width: 26px;
                        enabled: tabbar.viewport-width > tabbar.visible-width
                            && tabbar.viewport-x > tabbar.visible-width - tabbar.viewport-width;
                        clicked => {
                            tabbar.viewport-x = tabbar.viewport-x - 90px < tabbar.visible-width - tabbar.viewport-width
                                ? tabbar.visible-width - tabbar.viewport-width
                                : tabbar.viewport-x - 90px;
                        }
                    }
                }
                // Treść zakładki (jedna widoczna naraz — indeks jak w `tab-titles`).
                if root.right-tab == 0: VerticalLayout {
                    vertical-stretch: 1;
                        VerticalBox {
                            padding: 4px;
                            padding-top: 10px;
                            spacing: 6px;
                            // Nagłówek: co pokazujemy (zmiany względem oryginału/importu).
                            Text {
                                text: root.t-changes-header;
                                color: #8a8a96;
                                font-size: 12px;
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                Text {
                                    text: root.changes-text == "" ? root.t-no-changes : root.changes-text;
                                    color: #c4c4cc;
                                    font-family: "monospace";
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                if root.right-tab == 1: VerticalLayout {
                    vertical-stretch: 1;
                        VerticalBox {
                            padding: 4px;
                            spacing: 4px;
                            HorizontalBox {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: root.t-binary + " · " + root.bin-groups.length + " " + root.t-fields;
                                    color: #8a8a96;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: root.bin-hex ? "HEX" : "DEC";
                                    clicked => { root.bin-hex = !root.bin-hex; }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalBox {
                                    padding: 0px;
                                    spacing: 1px;
                                    for g[i] in root.bin-groups: Rectangle {
                                        background: Math.mod(i, 2) == 0 ? #22222a : #1e1e24;
                                        HorizontalBox {
                                            padding: 3px;
                                            spacing: 8px;
                                            // Offset (hex) — stała szerokość.
                                            Text {
                                                width: 52px;
                                                text: g.addr;
                                                color: #6a6a76;
                                                font-family: "monospace";
                                                font-size: 11px;
                                            }
                                            // Etykieta pola — kolor wg rodzaju.
                                            Text {
                                                width: 150px;
                                                text: g.label;
                                                color: g.kind == "selector" ? #7fb4ff
                                                    : (g.kind == "param" ? #c4c4cc
                                                    : (g.kind == "name" ? #7fd98a
                                                    : (g.kind == "ir" ? #d9a97f
                                                    : (g.kind == "header" ? #b08ad0 : #8a8a96))));
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                            // Bajty — hex lub dec wg przełącznika.
                                            Text {
                                                text: (root.bin-hex ? g.hex : g.dec)
                                                    + (g.truncated ? " …(" + g.length + " B)" : "");
                                                color: white;
                                                font-family: "monospace";
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                if root.right-tab == 2: VerticalLayout {
                    vertical-stretch: 1;
                        VerticalBox {
                            padding: 4px;
                            spacing: 4px;
                            chat-scroll := ScrollView {
                                vertical-stretch: 1;
                                // Viewport o szerokości okna → Text zawija się i
                                // wysokość treści liczy się poprawnie (pełny scroll).
                                viewport-width: self.visible-width;
                                VerticalLayout {
                                    width: chat-scroll.visible-width;
                                    padding: 4px;
                                    spacing: 6px;
                                    // Bez tego layout rozciąga dymki na całą wysokość
                                    // (jeden dymek wypełniał cały panel).
                                    alignment: start;
                                    for m[i] in root.chat-rows: Rectangle {
                                        background: m.role == "user" ? #2a3550
                                            : (m.role == "tool" ? #2a2a30 : #2f3a2f);
                                        border-radius: 5px;
                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 2px;
                                            Text {
                                                // Rola po ludzku, wyróżniona kolorem roli.
                                                text: m.role == "user" ? "Ty"
                                                    : (m.role == "tool" ? root.t-role-tool : root.t-role-assistant);
                                                color: m.role == "user" ? #9db4ff
                                                    : (m.role == "tool" ? #b0b0bc : #9bd99b);
                                                font-size: 10px;
                                            }
                                            Text {
                                                text: m.text;
                                                color: white;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                            // Postęp przebiegu: agent potrafi pracować kilkadziesiąt
                            // sekund (wiele wywołań narzędzi). Bez tego UI wyglądał
                            // na zawieszony — zablokowany Send był jedynym sygnałem.
                            if root.agent-busy: Rectangle {
                                height: 26px;
                                border-radius: 5px;
                                background: #2f3a2f;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.agent-status;
                                        color: #9bd99b;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            Text {
                                text: root.usage-text;
                                color: #8a8a96;
                                font-size: 11px;
                            }
                            HorizontalBox {
                                spacing: 4px;
                                agent-input := LineEdit {
                                    placeholder-text: root.t-send + "…";
                                    enabled: !root.agent-busy;
                                    accepted(v) => {
                                        if (v != "") { root.send-message(v); self.text = ""; }
                                    }
                                }
                                Button {
                                    text: root.t-send;
                                    enabled: !root.agent-busy;
                                    clicked => {
                                        if (agent-input.text != "") {
                                            root.send-message(agent-input.text);
                                            agent-input.text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                if root.right-tab == 3: VerticalLayout {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding: 6px;
                        spacing: 8px;
                        alignment: start;

                        // Kropka + nagłówek: czy zewnętrzny agent JEST podłączony.
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                y: 4px;
                                background: root.mcp-clients > 0 ? #3ecf6b
                                    : (root.mcp-bridge-on ? #d8a033 : #6a6a76);
                            }
                            Text {
                                text: root.mcp-status;
                                color: #e6e6ea;
                                font-weight: 600;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            text: root.mcp-detail;
                            color: #8a8a96;
                            wrap: word-wrap;
                        }

                        Rectangle { height: 1px; background: #2a2a33; }

                        Text { text: root.t-mcp-hint; color: #8a8a96; wrap: word-wrap; }
                        Rectangle {
                            background: #16161c;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #2a2a33;
                            VerticalLayout {
                                padding: 8px;
                                Text {
                                    text: root.mcp-cmd;
                                    color: #cfcfd6;
                                    font-family: "Menlo";
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
                if root.right-tab == 4: VerticalLayout {
                    vertical-stretch: 1;
                        VerticalBox {
                            padding: 6px;
                            spacing: 6px;
                            HorizontalBox {
                                spacing: 6px;
                                alignment: start;
                                Button {
                                    text: root.midi-monitor-on ? "⏸ Stop" : "▶ " + root.t-midi-listen;
                                    primary: root.midi-monitor-on;
                                    clicked => { root.toggle-midi-monitor(); }
                                }
                                Button {
                                    text: root.t-clear;
                                    clicked => { root.clear-midi-log(); }
                                }
                                Button {
                                    text: root.t-save-file;
                                    clicked => { root.save-midi-log(); }
                                }
                            }
                            Text {
                                text: root.device-connected
                                    ? (root.midi-monitor-on ? root.t-midi-active : root.t-midi-idle)
                                    : root.t-midi-no-device;
                                color: #8a8a96;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            // TextEdit read-only: log przewijalny i ZAZNACZALNY (kopiowanie Cmd/Ctrl+C).
                            TextEdit {
                                vertical-stretch: 1;
                                read-only: true;
                                wrap: no-wrap;
                                text: root.midi-log == "" ? root.t-midi-empty : root.midi-log;
                            }
                        }
                    }
                if root.right-tab == 5: VerticalLayout {
                    vertical-stretch: 1;
                        VerticalBox {
                            padding: 8px;
                            spacing: 10px;
                            alignment: start;
                            Text {
                                text: root.device-connected ? root.t-drum-hint : root.t-connect-control;
                                color: #8a8a96; font-size: 11px; wrap: word-wrap;
                            }
                            // Play/Stop (CC81)
                            HorizontalBox {
                                spacing: 8px; alignment: start;
                                Button {
                                    text: "▶ Play";
                                    enabled: root.device-connected;
                                    clicked => { root.send-control(81, 1); }
                                }
                                Button {
                                    text: "⏹ Stop";
                                    enabled: root.device-connected;
                                    clicked => { root.send-control(81, 0); }
                                }
                                Text {
                                    text: root.drum-tempo >= 0 ? root.drum-tempo + " BPM" : "— BPM";
                                    color: #c8b6ff; vertical-alignment: center;
                                }
                            }
                            // Tempo (BPM) — odczyt z urządzenia + zapis ramką SysEx.
                            Text { text: root.t-drum-tempo; color: #8a8a96; font-size: 11px; }
                            HorizontalBox {
                                spacing: 6px; alignment: start;
                                drum-bpm := LineEdit {
                                    width: 80px;
                                    input-type: number;
                                    enabled: root.device-connected;
                                    text: root.drum-tempo >= 0 ? root.drum-tempo : 120;
                                    accepted(t) => { root.send-drum-tempo(Math.round(t.to-float())); }
                                }
                                Button {
                                    text: root.t-set;
                                    enabled: root.device-connected;
                                    clicked => { root.send-drum-tempo(Math.round(drum-bpm.text.to-float())); }
                                }
                                Button {
                                    text: "−5";
                                    enabled: root.device-connected;
                                    clicked => { root.send-drum-tempo(Math.round(drum-bpm.text.to-float()) - 5); }
                                }
                                Button {
                                    text: "+5";
                                    enabled: root.device-connected;
                                    clicked => { root.send-drum-tempo(Math.round(drum-bpm.text.to-float()) + 5); }
                                }
                            }
                            // Volume (CC83, 0..100)
                            Text { text: root.t-drum-volume; color: #8a8a96; font-size: 11px; }
                            drum-vol := Slider {
                                minimum: 0; maximum: 100; value: 50;
                                enabled: root.device-connected;
                                changed(v) => { root.send-control(83, Math.round(v)); }
                            }
                            // Wzorzec — dwupoziomowy wybór: grupa → wzorzec (CC82).
                            Text { text: root.t-drum-group; color: #8a8a96; font-size: 11px; }
                            ComboBox {
                                model: root.drum-group-names;
                                current-index: root.drum-group-index;
                                enabled: root.device-connected;
                                selected => {
                                    root.drum-group-index = self.current-index;
                                    drum-pat.current-index = 0;
                                    root.send-control(82, root.drum-group-base[self.current-index]);
                                }
                            }
                            Text { text: root.t-drum-pattern; color: #8a8a96; font-size: 11px; }
                            drum-pat := ComboBox {
                                model: root.drum-group-patterns[root.drum-group-index];
                                current-index: 0;
                                enabled: root.device-connected;
                                selected => {
                                    root.send-control(82, root.drum-group-base[root.drum-group-index] + self.current-index);
                                }
                            }
                        }
                    }
                    // Metadane otwartego patcha: autorstwo, pochodzenie, warunki użycia.
                if root.right-tab == 6: VerticalLayout {
                    vertical-stretch: 1;
                        ScrollView {
                            VerticalBox {
                                padding: 8px;
                                spacing: 6px;
                                alignment: start;
                                if !root.has-selection: Text {
                                    text: root.t-meta-no-selection;
                                    color: #8a8a96; font-size: 11px; wrap: word-wrap;
                                }
                                if root.has-selection: VerticalBox {
                                    padding: 0px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text { text: root.t-meta-author; color: #8a8a96; font-size: 11px; }
                                    meta-author := LineEdit {
                                        text: root.meta-author;
                                        placeholder-text: root.t-ph-author;
                                    }
                                    Text { text: root.t-meta-source; color: #8a8a96; font-size: 11px; }
                                    meta-source := LineEdit {
                                        text: root.meta-source;
                                        placeholder-text: root.t-ph-source;
                                    }
                                    Text { text: root.t-meta-source-url; color: #8a8a96; font-size: 11px; }
                                    HorizontalBox {
                                        padding: 0px; spacing: 4px;
                                        meta-url := LineEdit {
                                            text: root.meta-source-url;
                                            placeholder-text: "https://…";
                                        }
                                        Button {
                                            text: root.t-open;
                                            enabled: meta-url.text != "";
                                            clicked => { root.open-url(meta-url.text); }
                                        }
                                    }
                                    Text { text: root.t-meta-license; color: #8a8a96; font-size: 11px; }
                                    meta-license := LineEdit {
                                        text: root.meta-license;
                                        placeholder-text: root.t-ph-license;
                                    }
                                    Text { text: root.t-meta-notes; color: #8a8a96; font-size: 11px; }
                                    meta-notes := LineEdit {
                                        text: root.meta-notes;
                                    }
                                    // Ocena 0–5 + ulubiony.
                                    Text { text: root.t-meta-rating; color: #8a8a96; font-size: 11px; }
                                    HorizontalBox {
                                        padding: 0px; spacing: 4px; alignment: start;
                                        for star[i] in [1, 2, 3, 4, 5]: Button {
                                            text: root.meta-rating >= star ? "★" : "☆";
                                            clicked => {
                                                root.save-meta(meta-author.text, meta-source.text, meta-url.text,
                                                    meta-license.text, meta-notes.text, star, fav.checked);
                                            }
                                        }
                                        Button {
                                            text: root.t-meta-no-rating;
                                            clicked => {
                                                root.save-meta(meta-author.text, meta-source.text, meta-url.text,
                                                    meta-license.text, meta-notes.text, 0, fav.checked);
                                            }
                                        }
                                    }
                                    fav := CheckBox {
                                        text: root.t-meta-favorite;
                                        checked: root.meta-favorite;
                                        toggled => {
                                            root.save-meta(meta-author.text, meta-source.text, meta-url.text,
                                                meta-license.text, meta-notes.text, root.meta-rating, self.checked);
                                        }
                                    }
                                    Button {
                                        text: root.t-meta-save;
                                        clicked => {
                                            root.save-meta(meta-author.text, meta-source.text, meta-url.text,
                                                meta-license.text, meta-notes.text, root.meta-rating, fav.checked);
                                        }
                                    }
                                    // Tagi
                                    Text { text: root.t-meta-tags; color: #8a8a96; font-size: 11px; }
                                    HorizontalBox {
                                        padding: 0px; spacing: 4px;
                                        new-tag := LineEdit { placeholder-text: root.t-ph-tag; }
                                        Button {
                                            text: root.t-add;
                                            enabled: new-tag.text != "";
                                            clicked => { root.add-tag(new-tag.text); new-tag.text = ""; }
                                        }
                                    }
                                    for tag in root.meta-tags: HorizontalBox {
                                        padding: 0px; spacing: 4px; alignment: start;
                                        Text { text: "🏷 " + tag; color: white; vertical-alignment: center; }
                                        Button {
                                            text: "✕";
                                            clicked => { root.remove-tag(tag); }
                                        }
                                    }
                                    // Kolekcje
                                    Text { text: root.t-meta-collections; color: #8a8a96; font-size: 11px; }
                                    HorizontalBox {
                                        padding: 0px; spacing: 4px;
                                        new-coll := LineEdit { placeholder-text: root.t-ph-collection; }
                                        Button {
                                            text: root.t-create;
                                            enabled: new-coll.text != "";
                                            clicked => { root.new-collection(new-coll.text); new-coll.text = ""; }
                                        }
                                    }
                                    for c in root.collections: CheckBox {
                                        text: c.name + " (" + c.count + ")";
                                        checked: c.member;
                                        toggled => { root.toggle-collection(c.id, self.checked); }
                                    }
                                }
                            }
                        }
                    }
                    // Katalog publicznych źródeł patchy — ODNOŚNIKI, nie pliki.
                if root.right-tab == 7: VerticalLayout {
                    vertical-stretch: 1;
                        ScrollView {
                            VerticalBox {
                                padding: 8px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: root.t-sources-intro;
                                    color: #8a8a96; font-size: 11px; wrap: word-wrap;
                                }
                                for s in root.patch-sources: VerticalBox {
                                    padding: 6px;
                                    spacing: 2px;
                                    alignment: start;
                                    HorizontalBox {
                                        padding: 0px; spacing: 6px; alignment: start;
                                        Text {
                                            text: s.name;
                                            color: white; font-size: 13px; font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        if s.paid: Text {
                                            text: root.t-sources-paid;
                                            color: #ffb86c; font-size: 10px; vertical-alignment: center;
                                        }
                                    }
                                    Text { text: root.t-sources-author + " " + s.author; color: #c8b6ff; font-size: 11px; wrap: word-wrap; }
                                    Text { text: s.description; color: #8a8a96; font-size: 11px; wrap: word-wrap; }
                                    Text { text: root.t-sources-license + " " + s.license; color: #6a6a76; font-size: 10px; wrap: word-wrap; }
                                    Button {
                                        text: root.t-sources-open;
                                        clicked => { root.open-url(s.url); }
                                    }
                                }
                            }
                        }
                    }
                if root.right-tab == 8: VerticalLayout {
                    vertical-stretch: 1;
                        ScrollView {
                          VerticalBox {
                            padding: 6px;
                            spacing: 6px;
                            alignment: start;
                            Text { text: root.t-provider; color: #8a8a96; font-size: 11px; }
                            // Backend 2 = Claude Code: płaci SUBSKRYPCJA, klucz API zbędny.
                            provider-combo := ComboBox {
                                model: ["Anthropic API", "OpenAI-compatible", "Claude Code (" + root.t-subscription + ")"];
                                current-index: root.provider-index;
                            }
                            // Endpoint/model/klucz mają sens tylko dla backendów HTTP.
                            if provider-combo.current-index != 2: VerticalBox {
                                padding: 0px; spacing: 6px;
                                Text { text: root.t-endpoint; color: #8a8a96; font-size: 11px; }
                                endpoint-edit := LineEdit { text: root.cfg-endpoint; edited => { root.cfg-endpoint = self.text; } }
                                Text { text: root.t-model; color: #8a8a96; font-size: 11px; }
                                model-edit := LineEdit { text: root.cfg-model; edited => { root.cfg-model = self.text; } }
                                Text { text: root.t-key; color: #8a8a96; font-size: 11px; }
                                key-edit := LineEdit { text: root.cfg-key; input-type: password; edited => { root.cfg-key = self.text; } }
                            }
                            if provider-combo.current-index == 2: VerticalBox {
                                padding: 0px; spacing: 4px;
                                Text {
                                    text: root.t-cc-hint;
                                    color: #9bd99b; font-size: 11px; wrap: word-wrap;
                                }
                                Text { text: root.t-cc-bin; color: #8a8a96; font-size: 11px; }
                                claude-bin-edit := LineEdit {
                                    text: root.cfg-claude-bin;
                                    placeholder-text: "claude";
                                    edited => { root.cfg-claude-bin = self.text; }
                                }
                            }
                            // Mostek MCP: bez niego Claude Code nie ma czym edytować
                            // Biblioteki, a zewnętrzne klienty MCP widzą tylko pliki.
                            Rectangle { height: 1px; background: #3a3a44; }
                            bridge-check := CheckBox {
                                text: root.t-bridge;
                                checked: root.cfg-bridge;
                            }
                            Text {
                                text: root.cfg-bridge-status;
                                color: #8a8a96; font-size: 10px; wrap: word-wrap;
                            }
                            Button {
                                text: root.t-save;
                                clicked => {
                                    root.save-settings(
                                        provider-combo.current-index,
                                        root.cfg-endpoint,
                                        root.cfg-model,
                                        root.cfg-key,
                                        bridge-check.checked,
                                        root.cfg-claude-bin);
                                }
                            }
                          }
                        }
                    }
                }
            }
        }
    }

    // pasek błędu (na dole, gdy niepusty)
    if root.error-text != "": Rectangle {
        y: root.height - 40px;
        height: 40px;
        background: #7a2020;
        HorizontalBox {
            padding-left: 12px;
            Text {
                text: root.error-text;
                color: white;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "✕"; clicked => { root.dismiss-error(); } }
        }
    }
}
